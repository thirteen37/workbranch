#!/usr/bin/env zsh
# wb-nuke - Clean up merged worktrees (and optionally WIP worktrees)
# Usage: wb-nuke [--wip] [--dry-run]
#
# DANGEROUS: This removes worktrees and optionally their branches!

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/wb-lib"

usage() {
    echo "Usage: wb-nuke [--wip] [--dry-run] [--verbose] [--json]"
    echo ""
    echo "Removes worktrees for branches that have been merged into the default branch."
    echo ""
    echo "Options:"
    echo "  --wip       Also remove WIP (unmerged) worktrees (DANGEROUS!)"
    echo "  --dry-run   Show what would be removed without actually removing"
    echo "  --verbose   Show detailed output"
    echo "  --json      Output result as JSON"
    echo ""
    echo "WARNING: This is a destructive operation!"
    exit 1
}

# Parse output control flags first
wb_parse_output_flags "$@"
set -- "${WB_REMAINING_ARGS[@]}"

# Parse arguments
include_wip=false
dry_run=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --wip) include_wip=true ;;
        --dry-run) dry_run=true ;;
        -h|--help) usage ;;
        *) echo "ERROR: Unknown option: $1 | ACTION: Use -h or --help to see valid options"; exit 1 ;;
    esac
    shift
done

# Verify we're in a git repository
git_root=$(wb_require_git_root)

# Get default branch
default_branch=$(wb_get_default_branch)
if [[ -z "$default_branch" ]]; then
    echo "ERROR: Cannot determine default branch | ACTION: Ensure remote is configured"
    exit 1
fi

# Get main worktree (cannot be removed)
main_worktree=$(wb_get_main_worktree)

wb_log_milestone "Analyzing worktrees"
wb_log_progress "Default branch: $default_branch"
wb_log_progress "Main worktree: $main_worktree"

merged_worktrees=()
wip_worktrees=()

current_worktree=""
current_branch=""

while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ '^worktree (.+)$' ]]; then
        # Process previous worktree
        if [[ -n "$current_worktree" && "$current_worktree" != "$main_worktree" && -n "$current_branch" ]]; then
            # Check if branch is merged (using merge-base to avoid regex issues with branch names)
            if git merge-base --is-ancestor "$current_branch" "$default_branch" 2>/dev/null; then
                merged_worktrees+=("$current_worktree|$current_branch")
            else
                wip_worktrees+=("$current_worktree|$current_branch")
            fi
        fi
        current_worktree="$match[1]"
        current_branch=""
    elif [[ "$line" =~ '^branch refs/heads/(.+)$' ]]; then
        current_branch="$match[1]"
    fi
done < <(git worktree list --porcelain)

# Process last worktree
if [[ -n "$current_worktree" && "$current_worktree" != "$main_worktree" && -n "$current_branch" ]]; then
    if git merge-base --is-ancestor "$current_branch" "$default_branch" 2>/dev/null; then
        merged_worktrees+=("$current_worktree|$current_branch")
    else
        wip_worktrees+=("$current_worktree|$current_branch")
    fi
fi

# Report findings (text mode only or verbose)
if [[ "$WB_OUTPUT_FORMAT" != "json" ]]; then
    echo "MERGED WORKTREES (safe to remove):"
    if [[ ${#merged_worktrees[@]} -eq 0 ]]; then
        echo "  (none)"
    else
        for entry in "${merged_worktrees[@]}"; do
            local wt_path="${entry%%|*}"
            local wt_branch="${entry#*|}"
            echo "  $wt_path ($wt_branch)"
        done
    fi
    echo ""

    echo "WIP WORKTREES (unmerged):"
    if [[ ${#wip_worktrees[@]} -eq 0 ]]; then
        echo "  (none)"
    else
        for entry in "${wip_worktrees[@]}"; do
            local wt_path="${entry%%|*}"
            local wt_branch="${entry#*|}"
            echo "  $wt_path ($wt_branch)"
        done
    fi
    echo ""
fi

# Determine what to remove
to_remove=("${merged_worktrees[@]}")
if $include_wip; then
    to_remove+=("${wip_worktrees[@]}")
fi

if [[ ${#to_remove[@]} -eq 0 ]]; then
    wb_output_start
    wb_output_field "removed_count" "0"
    wb_output_field "failed_count" "0"
    wb_output_field "message" "Nothing to remove"
    wb_output_end
    exit 0
fi

# Dry run or actual removal
if $dry_run; then
    if [[ "$WB_OUTPUT_FORMAT" != "json" ]]; then
        echo "DRY RUN - Would remove:"
        for entry in "${to_remove[@]}"; do
            local dr_path="${entry%%|*}"
            local dr_branch="${entry#*|}"
            echo "  Worktree: $dr_path"
            echo "  Branch: $dr_branch"
            echo ""
        done
        echo "Run without --dry-run to actually remove."
    else
        # JSON output for dry-run
        wb_output_start
        wb_output_field "dry_run" "true"
        wb_output_field "would_remove_count" "${#to_remove[@]}"
        wb_output_end
    fi
    exit 0
fi

# Actual removal
wb_log_milestone "Removing worktrees"
removed_count=0
failed_count=0
typeset -ga removed_list
typeset -ga failed_list

for entry in "${to_remove[@]}"; do
    local rm_path="${entry%%|*}"
    local rm_branch="${entry#*|}"

    wb_log_progress "Removing: $rm_path ($rm_branch)"

    # Remove worktree
    if wb_run_git worktree remove "$rm_path"; then
        wb_log_progress "  Worktree removed"

        # Delete branch
        if wb_run_git branch -d "$rm_branch"; then
            wb_log_progress "  Branch deleted"
        else
            wb_log_progress "  WARNING: Could not delete branch"
        fi
        ((++removed_count))
        removed_list+=("$rm_path|$rm_branch")
    else
        wb_log_progress "  ERROR: Failed to remove worktree"
        ((++failed_count))
        failed_list+=("$rm_path|$rm_branch")
    fi
done

# Output structured result
wb_output_start
wb_output_field "removed_count" "$removed_count"
wb_output_field "failed_count" "$failed_count"
wb_output_field "total_processed" "${#to_remove[@]}"
wb_output_field "status" "$([[ $failed_count -eq 0 ]] && echo 'success' || echo 'partial')"
wb_output_end

if [[ $failed_count -gt 0 ]]; then
    if [[ "$WB_OUTPUT_FORMAT" != "json" ]]; then
        echo "ERROR: Some worktrees could not be removed | ACTION: Check for uncommitted changes or use 'git worktree remove --force'"
    fi
    exit 1
fi
