#!/usr/bin/env zsh
# wb-test - Integration tests for workbranch scripts
# Usage: wb-test [--verbose]

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
VERBOSE=false
TESTS_RUN=0
TESTS_PASSED=0
TESTS_FAILED=0

# Colors (disabled if not a terminal)
if [[ -t 1 ]]; then
    RED='\033[0;31m'
    GREEN='\033[0;32m'
    YELLOW='\033[0;33m'
    NC='\033[0m'
else
    RED='' GREEN='' YELLOW='' NC=''
fi

usage() {
    echo "Usage: wb-test [--verbose]"
    echo ""
    echo "Run integration tests for workbranch scripts."
    echo ""
    echo "Options:"
    echo "  --verbose    Show detailed output for each test"
    echo "  -h, --help   Show this help message"
    exit 0
}

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --verbose) VERBOSE=true; shift ;;
        -h|--help) usage ;;
        *) echo "ERROR: Unknown option: $1 | ACTION: Use -h or --help to see valid options"; exit 1 ;;
    esac
done

log() {
    if $VERBOSE; then
        echo "  $*"
    fi
}

pass() {
    ((++TESTS_PASSED))
    ((++TESTS_RUN))
    echo -e "${GREEN}PASS${NC}: $1"
}

fail() {
    ((++TESTS_FAILED))
    ((++TESTS_RUN))
    echo -e "${RED}FAIL${NC}: $1"
    if [[ -n "${2:-}" ]]; then
        echo "      $2"
    fi
}

# Setup test environment
setup() {
    TEST_DIR=$(mktemp -d)
    log "Created test directory: $TEST_DIR"

    # Create a bare repo to act as "origin"
    ORIGIN_DIR="$TEST_DIR/origin.git"
    git init --bare "$ORIGIN_DIR" >/dev/null 2>&1
    log "Created bare origin repo: $ORIGIN_DIR"

    # Create main working repo
    REPO_DIR="$TEST_DIR/repo"
    git clone "$ORIGIN_DIR" "$REPO_DIR" >/dev/null 2>&1
    cd "$REPO_DIR"

    # Initial commit
    echo "test" > file.txt
    git add file.txt
    git commit -m "Initial commit" >/dev/null 2>&1
    git push -u origin main >/dev/null 2>&1
    log "Created repo with initial commit: $REPO_DIR"
}

# Cleanup test environment
cleanup() {
    if [[ -n "${TEST_DIR:-}" && -d "$TEST_DIR" ]]; then
        rm -rf "$TEST_DIR"
        log "Cleaned up test directory"
    fi
}

trap cleanup EXIT

# =============================================================================
# Tests
# =============================================================================

test_wb_list_shows_main() {
    local output
    output=$("$SCRIPT_DIR/wb-list" 2>&1) || true
    if echo "$output" | grep -q "branch: main"; then
        pass "wb-list shows main branch"
    else
        fail "wb-list shows main branch" "Output: $output"
    fi
}

test_wb_new_creates_worktree() {
    local output
    output=$("$SCRIPT_DIR/wb-new" test-branch 2>&1) || true

    # Default path template is ../$NAME, so worktree is at $TEST_DIR/test-branch
    if echo "$output" | grep -q "SUCCESS"; then
        if [[ -d "$TEST_DIR/test-branch" ]]; then
            pass "wb-new creates worktree"
        else
            fail "wb-new creates worktree" "Directory not found at $TEST_DIR/test-branch"
        fi
    else
        fail "wb-new creates worktree" "Output: $output"
    fi
}

test_wb_list_shows_new_worktree() {
    local output
    output=$("$SCRIPT_DIR/wb-list" 2>&1) || true
    if echo "$output" | grep -q "test-branch"; then
        pass "wb-list shows new worktree"
    else
        fail "wb-list shows new worktree" "Output: $output"
    fi
}

test_wb_new_with_slash_in_name() {
    local output
    output=$("$SCRIPT_DIR/wb-new" feature/login 2>&1) || true

    if echo "$output" | grep -q "SUCCESS"; then
        pass "wb-new handles branch names with slashes"
    else
        fail "wb-new handles branch names with slashes" "Output: $output"
    fi
}

test_wb_rm_removes_worktree() {
    local output worktree_path
    # First go back to main repo
    cd "$REPO_DIR"

    # Get actual worktree path from git (may differ from expected due to path resolution)
    worktree_path=$(git worktree list --porcelain | grep "worktree.*test-branch" | sed 's/^worktree //')
    log "Removing worktree at: $worktree_path"

    if [[ -z "$worktree_path" ]]; then
        fail "wb-rm removes worktree" "Could not find test-branch worktree"
        return
    fi

    output=$("$SCRIPT_DIR/wb-rm" "$worktree_path" --delete-branch 2>&1) || true

    if echo "$output" | grep -q "SUCCESS"; then
        if [[ ! -d "$worktree_path" ]]; then
            pass "wb-rm removes worktree"
        else
            fail "wb-rm removes worktree" "Directory still exists"
        fi
    else
        fail "wb-rm removes worktree" "Output: $output"
    fi
}

test_wb_lib_normalize_path() {
    source "$SCRIPT_DIR/wb-lib"

    local result
    result=$(wb_normalize_path "/foo/bar/../baz")
    if [[ "$result" == "/foo/baz" ]]; then
        pass "wb_normalize_path resolves .."
    else
        fail "wb_normalize_path resolves .." "Expected /foo/baz, got $result"
    fi
}

test_wb_lib_normalize_path_dot() {
    source "$SCRIPT_DIR/wb-lib"

    local result
    result=$(wb_normalize_path "/foo/./bar")
    if [[ "$result" == "/foo/bar" ]]; then
        pass "wb_normalize_path resolves ."
    else
        fail "wb_normalize_path resolves ." "Expected /foo/bar, got $result"
    fi
}

test_wb_lib_normalize_path_double_slash() {
    source "$SCRIPT_DIR/wb-lib"

    local result
    result=$(wb_normalize_path "/foo//bar")
    if [[ "$result" == "/foo/bar" ]]; then
        pass "wb_normalize_path resolves //"
    else
        fail "wb_normalize_path resolves //" "Expected /foo/bar, got $result"
    fi
}

test_wb_parse_config_defaults() {
    source "$SCRIPT_DIR/wb-lib"

    # Parse non-existent config (should use defaults)
    wb_parse_config "/nonexistent/path/.workbranch"

    if [[ "${WB_CONFIG[path]}" == '../$NAME' ]]; then
        pass "wb_parse_config sets default path"
    else
        fail "wb_parse_config sets default path" "Expected '../\$NAME', got '${WB_CONFIG[path]}'"
    fi
}

test_wb_parse_config_reads_file() {
    source "$SCRIPT_DIR/wb-lib"

    # Create temp config
    local temp_config
    temp_config=$(mktemp)
    echo 'copy=.env*:.vscode' > "$temp_config"
    echo 'path=../worktrees/$NAME' >> "$temp_config"
    echo 'post_create=npm install' >> "$temp_config"

    wb_parse_config "$temp_config"

    local passed=true
    if [[ "${WB_CONFIG[copy]}" != ".env*:.vscode" ]]; then
        fail "wb_parse_config reads copy" "Expected '.env*:.vscode', got '${WB_CONFIG[copy]}'"
        passed=false
    fi
    if [[ "${WB_CONFIG[path]}" != '../worktrees/$NAME' ]]; then
        fail "wb_parse_config reads path" "Expected '../worktrees/\$NAME', got '${WB_CONFIG[path]}'"
        passed=false
    fi
    if [[ "${WB_CONFIG[post_create]}" != "npm install" ]]; then
        fail "wb_parse_config reads post_create" "Expected 'npm install', got '${WB_CONFIG[post_create]}'"
        passed=false
    fi

    rm -f "$temp_config"

    if $passed; then
        pass "wb_parse_config reads file correctly"
    fi
}

test_wb_parse_config_handles_quotes() {
    source "$SCRIPT_DIR/wb-lib"

    # Create temp config with quoted values
    local temp_config
    temp_config=$(mktemp)
    echo 'post_create="npm install && npm test"' > "$temp_config"

    wb_parse_config "$temp_config"

    if [[ "${WB_CONFIG[post_create]}" == "npm install && npm test" ]]; then
        pass "wb_parse_config handles quoted values"
    else
        fail "wb_parse_config handles quoted values" "Expected 'npm install && npm test', got '${WB_CONFIG[post_create]}'"
    fi

    rm -f "$temp_config"
}

test_wb_done_discard_changes() {
    cd "$REPO_DIR"

    # Create a new worktree for testing
    local output
    output=$("$SCRIPT_DIR/wb-new" test-discard 2>&1) || true
    if ! echo "$output" | grep -q "SUCCESS"; then
        fail "wb-done --discard-changes (setup)" "Failed to create worktree: $output"
        return
    fi

    # Find the worktree path
    local worktree_path
    worktree_path=$(git worktree list --porcelain | grep "worktree.*test-discard" | sed 's/^worktree //')
    if [[ -z "$worktree_path" ]]; then
        fail "wb-done --discard-changes (setup)" "Could not find test-discard worktree"
        return
    fi

    # Create uncommitted changes in the worktree (modify existing tracked file)
    echo "modified content" >> "$worktree_path/file.txt"
    log "Modified tracked file in $worktree_path"

    # Ensure we're in main worktree for wb-done (resolve symlinks for macOS /var -> /private/var)
    cd "$REPO_DIR"
    cd "$(pwd -P)"

    # Verify wb-done without --discard-changes fails
    output=$("$SCRIPT_DIR/wb-done" test-discard --skip-merge 2>&1) || true
    if echo "$output" | grep -q "ERROR.*Uncommitted changes"; then
        log "wb-done correctly rejected uncommitted changes"
    else
        fail "wb-done rejects uncommitted changes" "Expected error, got: $output"
        return
    fi

    # Verify wb-done --discard-changes succeeds
    output=$("$SCRIPT_DIR/wb-done" test-discard --skip-merge --discard-changes 2>&1) || true
    if echo "$output" | grep -q "SUCCESS"; then
        if [[ ! -d "$worktree_path" ]]; then
            pass "wb-done --discard-changes removes dirty worktree"
        else
            fail "wb-done --discard-changes removes dirty worktree" "Worktree still exists at $worktree_path"
        fi
    else
        fail "wb-done --discard-changes removes dirty worktree" "Output: $output"
    fi
}

test_no_remote() {
    # Create a local-only repo (no remote)
    local local_repo
    local_repo="$TEST_DIR/local-only"
    mkdir -p "$local_repo"
    cd "$local_repo"
    git init >/dev/null 2>&1
    git config user.email "test@example.com"
    git config user.name "Test User"

    # Initial commit
    echo "test" > file.txt
    git add file.txt
    git commit -m "Initial commit" >/dev/null 2>&1
    log "Created local-only repo: $local_repo"

    # Test wb-new works without remote
    local output
    output=$("$SCRIPT_DIR/wb-new" feature-no-remote 2>&1) || true
    if echo "$output" | grep -q "SUCCESS"; then
        pass "wb-new works without remote"
    else
        fail "wb-new works without remote" "Output: $output"
        return
    fi

    # Test wb-list works without remote
    output=$("$SCRIPT_DIR/wb-list" 2>&1) || true
    if echo "$output" | grep -q "feature-no-remote"; then
        pass "wb-list works without remote"
    else
        fail "wb-list works without remote" "Output: $output"
    fi

    # Make a change in the worktree
    local worktree_path
    worktree_path="$TEST_DIR/feature-no-remote"
    echo "change" >> "$worktree_path/file.txt"
    cd "$worktree_path"
    git add file.txt
    git commit -m "Change" >/dev/null 2>&1

    # Return to main worktree and resolve symlinks (for macOS)
    cd "$local_repo"
    cd "$(pwd -P)"

    # Test wb-done --local-only works
    output=$("$SCRIPT_DIR/wb-done" feature-no-remote --local-only 2>&1) || true
    if echo "$output" | grep -q "SUCCESS"; then
        pass "wb-done --local-only works without remote"
    else
        fail "wb-done --local-only works without remote" "Output: $output"
        return
    fi

    # Create another worktree to test warning
    "$SCRIPT_DIR/wb-new" feature-remote-test >/dev/null 2>&1
    worktree_path="$TEST_DIR/feature-remote-test"
    echo "change" >> "$worktree_path/file.txt"
    cd "$worktree_path"
    git add file.txt
    git commit -m "Change" >/dev/null 2>&1

    # Return to main worktree and resolve symlinks (for macOS)
    cd "$local_repo"
    cd "$(pwd -P)"

    # Test that wb-done without --skip-merge warns about no remote
    output=$("$SCRIPT_DIR/wb-done" feature-remote-test 2>&1) || true
    if echo "$output" | grep -q "No remote configured"; then
        pass "wb-done warns about no remote"
    else
        fail "wb-done warns about no remote" "Output: $output"
    fi

    # Cleanup the test worktree (if it still exists)
    cd "$local_repo"
    cd "$(pwd -P)"
    git worktree remove --force "$TEST_DIR/feature-remote-test" 2>/dev/null || true
    git branch -D feature-remote-test 2>/dev/null || true

    # Return to original test repo
    cd "$REPO_DIR"
}

# Verbosity control tests
test_wb_parse_output_flags() {
    source "$SCRIPT_DIR/wb-lib"

    # Test default (no flags)
    wb_parse_output_flags "arg1" "arg2"
    if [[ "$WB_VERBOSE" -eq 0 && "$WB_OUTPUT_FORMAT" == "text" && "${#WB_REMAINING_ARGS[@]}" -eq 2 ]]; then
        pass "wb_parse_output_flags: default values"
    else
        fail "wb_parse_output_flags: default values" "VERBOSE=$WB_VERBOSE FORMAT=$WB_OUTPUT_FORMAT REMAINING=${WB_REMAINING_ARGS[@]}"
    fi

    # Test --verbose
    wb_parse_output_flags "--verbose" "arg1"
    if [[ "$WB_VERBOSE" -eq 1 && "${#WB_REMAINING_ARGS[@]}" -eq 1 ]]; then
        pass "wb_parse_output_flags: --verbose flag"
    else
        fail "wb_parse_output_flags: --verbose flag" "VERBOSE=$WB_VERBOSE REMAINING=${WB_REMAINING_ARGS[@]}"
    fi

    # Test --json
    wb_parse_output_flags "--json" "arg1"
    if [[ "$WB_OUTPUT_FORMAT" == "json" && "${#WB_REMAINING_ARGS[@]}" -eq 1 ]]; then
        pass "wb_parse_output_flags: --json flag"
    else
        fail "wb_parse_output_flags: --json flag" "FORMAT=$WB_OUTPUT_FORMAT REMAINING=${WB_REMAINING_ARGS[@]}"
    fi
}

test_wb_log_functions() {
    source "$SCRIPT_DIR/wb-lib"

    # Test wb_log_milestone in text mode
    WB_OUTPUT_FORMAT="text"
    local output
    output=$(wb_log_milestone "Test milestone")
    if [[ "$output" == "Test milestone" ]]; then
        pass "wb_log_milestone: text mode"
    else
        fail "wb_log_milestone: text mode" "Output: $output"
    fi

    # Test wb_log_milestone in JSON mode (should be silent)
    WB_OUTPUT_FORMAT="json"
    output=$(wb_log_milestone "Test milestone")
    if [[ -z "$output" ]]; then
        pass "wb_log_milestone: JSON mode silent"
    else
        fail "wb_log_milestone: JSON mode silent" "Output: $output"
    fi

    # Test wb_log_progress in verbose mode
    WB_VERBOSE=1
    WB_OUTPUT_FORMAT="text"
    output=$(wb_log_progress "Test progress")
    if [[ "$output" == "Test progress" ]]; then
        pass "wb_log_progress: verbose mode"
    else
        fail "wb_log_progress: verbose mode" "Output: $output"
    fi

    # Test wb_log_progress in quiet mode (should be silent)
    WB_VERBOSE=0
    output=$(wb_log_progress "Test progress")
    if [[ -z "$output" ]]; then
        pass "wb_log_progress: quiet mode silent"
    else
        fail "wb_log_progress: quiet mode silent" "Output: $output"
    fi
}

test_wb_output_functions() {
    source "$SCRIPT_DIR/wb-lib"

    # Test text mode
    WB_OUTPUT_FORMAT="text"
    local output
    output=$(wb_output_start; wb_output_field "key1" "value1"; wb_output_field "key2" "value2"; wb_output_end)
    if echo "$output" | grep -q "key1: value1" && echo "$output" | grep -q "key2: value2"; then
        pass "wb_output functions: text mode"
    else
        fail "wb_output functions: text mode" "Output: $output"
    fi

    # Test JSON mode
    WB_OUTPUT_FORMAT="json"
    output=$(wb_output_start; wb_output_field "key1" "value1"; wb_output_field "key2" "value2"; wb_output_end)
    if echo "$output" | grep -q '"key1": "value1"' && echo "$output" | grep -q '"key2": "value2"'; then
        pass "wb_output functions: JSON mode"
    else
        fail "wb_output functions: JSON mode" "Output: $output"
    fi
}

test_wb_list_json_output() {
    local output
    output=$("$SCRIPT_DIR/wb-list" --json 2>&1) || true

    # Check if output is valid JSON and contains expected fields
    if echo "$output" | grep -q '"worktrees"' && echo "$output" | grep -q '"count"'; then
        pass "wb-list --json: produces valid JSON"
    else
        fail "wb-list --json: produces valid JSON" "Output: $output"
    fi
}

test_wb_status_json_output() {
    local output
    output=$("$SCRIPT_DIR/wb-status" --json 2>&1) || true

    # Check if output is valid JSON and contains expected fields
    if echo "$output" | grep -q '"location"' && echo "$output" | grep -q '"branch"'; then
        pass "wb-status --json: produces valid JSON"
    else
        fail "wb-status --json: produces valid JSON" "Output: $output"
    fi
}

test_wb_new_verbose_output() {
    local output line_count

    # Test without --verbose (should be minimal)
    output=$("$SCRIPT_DIR/wb-new" test-verbose-check 2>&1) || true
    line_count=$(echo "$output" | wc -l)
    if [[ $line_count -lt 10 ]]; then
        pass "wb-new: default output is minimal"
    else
        fail "wb-new: default output is minimal" "Output has $line_count lines"
    fi

    # Cleanup
    cd "$REPO_DIR"
    local worktree_path
    worktree_path=$(git worktree list --porcelain | grep "worktree.*test-verbose-check" | sed 's/^worktree //')
    if [[ -n "$worktree_path" ]]; then
        git worktree remove --force "$worktree_path" 2>/dev/null || true
        git branch -D test-verbose-check 2>/dev/null || true
    fi
}

# =============================================================================
# Main
# =============================================================================

echo "Running workbranch integration tests..."
echo ""

setup

# Run tests
test_wb_list_shows_main
test_wb_new_creates_worktree
test_wb_list_shows_new_worktree
test_wb_new_with_slash_in_name
test_wb_rm_removes_worktree
test_wb_lib_normalize_path
test_wb_lib_normalize_path_dot
test_wb_lib_normalize_path_double_slash
test_wb_parse_config_defaults
test_wb_parse_config_reads_file
test_wb_parse_config_handles_quotes
test_wb_done_discard_changes
test_no_remote

# Verbosity control tests
test_wb_parse_output_flags
test_wb_log_functions
test_wb_output_functions
test_wb_list_json_output
test_wb_status_json_output
test_wb_new_verbose_output

# Summary
echo ""
echo "=========================================="
echo "Tests run: $TESTS_RUN"
echo -e "Passed: ${GREEN}$TESTS_PASSED${NC}"
if [[ $TESTS_FAILED -gt 0 ]]; then
    echo -e "Failed: ${RED}$TESTS_FAILED${NC}"
    exit 1
else
    echo -e "Failed: $TESTS_FAILED"
    echo ""
    echo "All tests passed!"
fi
