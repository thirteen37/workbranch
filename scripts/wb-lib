# wb-lib - Shared functions for workbranch scripts
# Source this file, don't execute it
# Requires: ZSH 5.0+

# Get git root, exit if not in repo
wb_require_git_root() {
    local git_root
    if ! git_root=$(git rev-parse --show-toplevel 2>/dev/null); then
        echo "ERROR: Not in a git repository | ACTION: Navigate to a git repository first"
        exit 1
    fi
    echo "$git_root"
}

# Get default branch with robust fallback (from wb-done's logic)
wb_get_default_branch() {
    local branch=""
    local ref
    # Try to get from remote HEAD (may fail if not set)
    if ref=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null); then
        branch="${ref#refs/remotes/origin/}"
    fi
    # Fallback to checking for main/master
    if [[ -z "$branch" ]]; then
        if git show-ref --verify --quiet refs/heads/main; then
            branch="main"
        elif git show-ref --verify --quiet refs/heads/master; then
            branch="master"
        fi
    fi
    echo "$branch"
}

# Get the remote name (origin, or first available, or empty string)
wb_get_remote() {
    local remote=""

    # Try "origin" first (most common)
    if git remote | grep -q "^origin$"; then
        remote="origin"
    else
        # Use first available remote
        remote=$(git remote | head -n 1)
    fi

    echo "$remote"
}

# Check if a remote is configured
# Returns: 0 if remote exists, 1 otherwise
wb_has_remote() {
    local remote
    remote=$(wb_get_remote)
    [[ -n "$remote" ]]
}

# Check if remote is network-reachable (not just configured)
# Returns: 0 if reachable, 1 otherwise (sandbox or network issue)
wb_check_remote_reachable() {
    local remote="$1"
    [[ -z "$remote" ]] && return 1

    # Quick connectivity check with timeout
    if ! git ls-remote --exit-code "$remote" HEAD >/dev/null 2>&1; then
        return 1
    fi
    return 0
}

# Detect if running in restricted sandbox environment
# Returns: 0 if in sandbox, 1 otherwise
wb_detect_sandbox() {
    # Try to create a test directory outside current path
    local test_dir="../.wb-sandbox-test-$$"
    if ! mkdir -p "$test_dir" 2>/dev/null; then
        return 0  # Sandbox detected
    fi
    rmdir "$test_dir" 2>/dev/null
    return 1  # Not in sandbox
}

# Check if path is writable
wb_check_writable() {
    local path="$1"
    local parent="${path:h}"

    # Try to create parent directory
    if ! mkdir -p "$parent" 2>/dev/null; then
        return 1
    fi

    # Check if we can write to it
    if ! touch "$parent/.wb-write-test-$$" 2>/dev/null; then
        return 1
    fi

    rm "$parent/.wb-write-test-$$" 2>/dev/null
    return 0
}

# Get the main (primary) worktree path
wb_get_main_worktree() {
    git worktree list --porcelain | awk '/^worktree / { print substr($0, 10); exit }'
}

# Normalize path (make absolute, resolve ..)
# Works even if intermediate directories don't exist
wb_normalize_path() {
    local path="$1"
    local base_dir="${2:-$(pwd)}"

    # Make absolute if relative
    if [[ "$path" != /* ]]; then
        path="$base_dir/$path"
    fi

    # Use realpath -m if available (GNU coreutils), otherwise pure ZSH
    # Note: macOS realpath doesn't support -m flag
    if realpath -m / &>/dev/null; then
        realpath -m "$path"
    else
        # Pure ZSH fallback using array splitting
        local -a parts result
        local part

        # Split path by /
        parts=("${(@s:/:)path}")

        # Process each part
        for part in "${parts[@]}"; do
            if [[ "$part" == ".." ]]; then
                # Go up one level (remove last element if exists)
                if (( ${#result[@]} > 0 )); then
                    result=("${result[@]:0:-1}")
                fi
            elif [[ "$part" != "." && -n "$part" ]]; then
                result+=("$part")
            fi
        done

        # Rejoin with /
        echo "/${(j:/:)result}"
    fi
}

# Parse .workbranch config file into WB_CONFIG associative array
# Usage: wb_parse_config /path/to/.workbranch
# Sets global WB_CONFIG array with keys: copy, ignore, path, post_create, delete_branch
wb_parse_config() {
    local config_file="$1"

    # Declare global associative array
    typeset -gA WB_CONFIG

    # Set defaults
    WB_CONFIG=(
        [copy]=""
        [ignore]="node_modules:dist:.git"
        [path]='../$NAME'
        [post_create]=""
        [delete_branch]="false"
    )

    # Return if config file doesn't exist
    [[ -f "$config_file" ]] || return 0

    local line key value
    while IFS= read -r line || [[ -n "$line" ]]; do
        # Skip comments and empty lines
        [[ "$line" =~ ^[[:space:]]*# ]] && continue
        [[ -z "${line// /}" ]] && continue

        # Split on first =
        key="${line%%=*}"
        value="${line#*=}"

        # Trim whitespace from key
        key="${key// /}"

        # Remove surrounding quotes from value
        value="${value#\"}"
        value="${value%\"}"
        value="${value#\'}"
        value="${value%\'}"

        # Store in array if key is valid
        case "$key" in
            copy|ignore|path|post_create|delete_branch)
                WB_CONFIG[$key]="$value"
                ;;
        esac
    done < "$config_file"
}

# Parse output control flags from arguments
# Sets global variables:
#   WB_VERBOSE=0|1 - whether to show detailed output
#   WB_OUTPUT_FORMAT=text|json - output format
#   WB_REMAINING_ARGS - array of remaining arguments
# Usage: wb_parse_output_flags "$@"
#        set -- "${WB_REMAINING_ARGS[@]}"
wb_parse_output_flags() {
    # Initialize globals
    typeset -ga WB_REMAINING_ARGS
    WB_REMAINING_ARGS=()
    typeset -g WB_VERBOSE=0
    typeset -g WB_OUTPUT_FORMAT="text"

    # Parse flags
    for arg in "$@"; do
        case "$arg" in
            --verbose)
                WB_VERBOSE=1
                ;;
            --json)
                WB_OUTPUT_FORMAT="json"
                ;;
            *)
                WB_REMAINING_ARGS+=("$arg")
                ;;
        esac
    done
}

# Log a major milestone (always shown)
# Usage: wb_log_milestone "Creating worktree"
wb_log_milestone() {
    local message="$1"
    [[ "$WB_OUTPUT_FORMAT" != "json" ]] && echo "$message"
}

# Log a progress step (verbose mode only)
# Usage: wb_log_progress "Copying config files..."
wb_log_progress() {
    local message="$1"
    if [[ "${WB_VERBOSE:-0}" -eq 1 && "$WB_OUTPUT_FORMAT" != "json" ]]; then
        echo "$message"
    fi
}

# Run git command with output control
# Captures stderr in WB_GIT_STDERR for error handling
# Shows output only in verbose mode
# Returns: git's exit code
# Usage: if ! wb_run_git worktree add "$path" "$branch"; then
#            echo "ERROR: Git failed: $WB_GIT_STDERR"
#        fi
wb_run_git() {
    local stderr_file="/tmp/claude/wb-git-stderr-$$"
    typeset -g WB_GIT_STDERR=""
    local exit_code

    # Ensure temp directory exists
    mkdir -p "/tmp/claude" 2>/dev/null || true

    # Run git command
    if [[ "${WB_VERBOSE:-0}" -eq 1 ]]; then
        # Verbose: show output, still capture stderr
        git "$@" 2> >(tee "$stderr_file" >&2)
        exit_code=$?
    else
        # Quiet: suppress all output, capture stderr
        git "$@" >/dev/null 2>"$stderr_file"
        exit_code=$?
    fi

    # Read stderr for caller to check
    if [[ -f "$stderr_file" ]]; then
        WB_GIT_STDERR=$(<"$stderr_file")
        rm -f "$stderr_file"
    fi

    return $exit_code
}

# Structured output helpers (key-value or JSON)
# Usage:
#   wb_output_start
#   wb_output_field "status" "success"
#   wb_output_field "branch" "$branch_name"
#   wb_output_end

# Start structured output
wb_output_start() {
    typeset -g WB_OUTPUT_FIRST_FIELD=1
    if [[ "${WB_OUTPUT_FORMAT:-text}" == "json" ]]; then
        echo "{"
    fi
}

# Output a field (key-value pair)
wb_output_field() {
    local key="$1"
    local value="$2"

    if [[ "${WB_OUTPUT_FORMAT:-text}" == "json" ]]; then
        # JSON format
        if [[ "${WB_OUTPUT_FIRST_FIELD:-1}" -eq 0 ]]; then
            echo ","
        fi
        # Escape quotes in value
        value="${value//\"/\\\"}"
        printf '  "%s": "%s"' "$key" "$value"
        WB_OUTPUT_FIRST_FIELD=0
    else
        # Text format (key: value)
        echo "${key}: ${value}"
    fi
}

# End structured output
wb_output_end() {
    if [[ "${WB_OUTPUT_FORMAT:-text}" == "json" ]]; then
        echo ""
        echo "}"
    fi
}
