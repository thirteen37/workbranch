#!/usr/bin/env zsh
# wb-list - List git worktrees with status information
# Usage: wb-list [-h|--help]
# Output format designed for Claude Code to parse

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/wb-lib"

usage() {
    echo "Usage: wb-list [options]"
    echo ""
    echo "Lists all git worktrees with status information."
    echo "Shows branch name and ahead/behind count vs default branch."
    echo ""
    echo "Options:"
    echo "  --verbose    Show detailed output"
    echo "  --json       Output as JSON"
    echo "  -h, --help   Show this help"
    exit 1
}

# Parse output control flags
wb_parse_output_flags "$@"
set -- "${WB_REMAINING_ARGS[@]}"

# Handle help flag
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
    usage
fi

# Get the git root directory
git_root=$(wb_require_git_root)

# Get default branch (main or master)
default_branch=$(wb_get_default_branch)
if [[ -z "$default_branch" ]]; then
    default_branch="main"  # fallback for display purposes
fi

# Store worktree info in global array
typeset -ga worktree_data
worktree_data=()

store_worktree() {
    local worktree="$1"
    local branch="$2"

    local ahead_behind="-"
    if [[ -n "$branch" && "$branch" != "(detached)" ]]; then
        ahead_behind=$(git rev-list --left-right --count "$default_branch...$branch" 2>/dev/null | tr '\t' '/' || echo "?/?")
    fi

    # Store as delimited string: path|branch|ahead_behind
    worktree_data+=("$worktree|$branch|$ahead_behind")
    ((++worktree_count))
}

# Parse git worktree list --porcelain
worktree_count=0
current_worktree=""
current_branch=""

while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" =~ '^worktree (.+)$' ]]; then
        # Store previous worktree if exists
        if [[ -n "$current_worktree" ]]; then
            store_worktree "$current_worktree" "$current_branch"
        fi
        current_worktree="$match[1]"
        current_branch=""
    elif [[ "$line" =~ '^branch refs/heads/(.+)$' ]]; then
        current_branch="$match[1]"
    elif [[ "$line" =~ '^detached$' ]]; then
        current_branch="(detached)"
    fi
done < <(git worktree list --porcelain)

# Store last worktree
if [[ -n "$current_worktree" ]]; then
    store_worktree "$current_worktree" "$current_branch"
fi

# Output results
if [[ "$WB_OUTPUT_FORMAT" == "json" ]]; then
    # JSON output
    echo "{"
    echo "  \"worktrees\": ["
    local first=1
    for entry in "${worktree_data[@]}"; do
        local -a parts
        parts=("${(@s:|:)entry}")
        local wt_path="${parts[1]}"
        local wt_branch="${parts[2]}"
        local wt_ahead_behind="${parts[3]}"

        if [[ $first -eq 0 ]]; then
            echo ","
        fi
        first=0

        echo "    {"
        echo "      \"path\": \"$wt_path\","
        echo "      \"branch\": \"$wt_branch\","
        echo "      \"ahead_behind\": \"$wt_ahead_behind\""
        printf "    }"
    done
    echo ""
    echo "  ],"
    echo "  \"count\": $worktree_count"
    echo "}"
else
    # Text output
    echo "WORKTREES:"
    echo "=========="
    for entry in "${worktree_data[@]}"; do
        local -a parts
        parts=("${(@s:|:)entry}")
        local wt_path="${parts[1]}"
        local wt_branch="${parts[2]}"
        local wt_ahead_behind="${parts[3]}"

        echo "  $wt_path"
        echo "    branch: $wt_branch"
        echo "    ahead/behind $default_branch: $wt_ahead_behind"
        echo ""
    done
    echo "Total: $worktree_count worktree(s)"
fi
