#!/usr/bin/env zsh
# wb-new - Create a new git worktree with config file copying
# Usage: wb-new <branch-name> [source-branch]

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/wb-lib"

usage() {
    echo "Usage: wb-new <branch-name> [source-branch] [--verbose] [--json]"
    echo ""
    echo "Creates a new git worktree for the specified branch."
    echo "If the branch doesn't exist, it will be created from source-branch (default: current branch)."
    echo ""
    echo "Options:"
    echo "  --verbose    Show detailed progress information"
    echo "  --json       Output results in JSON format"
    echo ""
    echo "Configuration is read from .workbranch in the project root."
    exit 1
}

# Parse output control flags first
wb_parse_output_flags "$@"
set -- "${WB_REMAINING_ARGS[@]}"

# Check arguments
if [[ $# -lt 1 ]]; then
    usage
fi

# Handle help flag
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
fi

branch_name="$1"
source_branch="${2:-HEAD}"

# Verify we're in a git repository
git_root=$(wb_require_git_root)

# Check if running in sandbox
if wb_detect_sandbox; then
    echo "ERROR: Running in sandbox environment with restricted write access | ACTION: Use one of these approaches:"
    echo "  1. Run outside sandbox (turn off sandbox with /sandbox command)"
    echo "  2. Use read-only commands: wb-list, wb-status"
    echo "  3. Use dry-run mode: wb-done --dry-run, wb-nuke --dry-run"
    exit 1
fi

# Load configuration using shared function
wb_parse_config "$git_root/.workbranch"

# Expand path template using ZSH substitution (handles / in branch names)
worktree_path="${WB_CONFIG[path]//\$NAME/$branch_name}"
worktree_path="${worktree_path//\$\{NAME\}/$branch_name}"

# Normalize path (make absolute if relative, resolve ..)
worktree_path=$(wb_normalize_path "$worktree_path" "$git_root")

# Check if worktree already exists
if git worktree list --porcelain | grep -q "^worktree $worktree_path$"; then
    echo "ERROR: Worktree already exists at $worktree_path | ACTION: Use existing worktree or remove it with wb-rm"
    exit 1
fi

# Check if branch exists
branch_exists=false
if git show-ref --verify --quiet "refs/heads/$branch_name" 2>/dev/null; then
    branch_exists=true
fi

# Create worktree
wb_log_milestone "Creating worktree for branch '$branch_name'..."

if $branch_exists; then
    wb_log_progress "Branch exists, checking out at $worktree_path"
    if ! wb_run_git worktree add "$worktree_path" "$branch_name"; then
        if [[ "$WB_GIT_STDERR" =~ "already checked out" ]]; then
            echo "ERROR: Branch is already checked out elsewhere | ACTION: Use wb-list to find where branch is checked out, or use wb-rm to remove the other worktree first"
        else
            echo "ERROR: Failed to create worktree | ACTION: Rerun with --verbose to see git output"
        fi
        exit 1
    fi
else
    wb_log_progress "Creating new branch from $source_branch at $worktree_path"
    if ! wb_run_git worktree add -b "$branch_name" "$worktree_path" "$source_branch"; then
        if [[ "$WB_GIT_STDERR" =~ "not a valid" || "$WB_GIT_STDERR" =~ "unknown revision" ]]; then
            echo "ERROR: Source branch '$source_branch' does not exist | ACTION: Check available branches with 'git branch -a'"
        else
            echo "ERROR: Failed to create worktree and branch | ACTION: Rerun with --verbose to see git output"
        fi
        exit 1
    fi
fi

wb_log_progress "Worktree created successfully"

# Copy config files if patterns specified
if [[ -n "${WB_CONFIG[copy]}" ]]; then
    wb_log_milestone "Copying config files..."

    # Split patterns using ZSH parameter expansion
    local -a patterns
    patterns=("${(@s.:.)WB_CONFIG[copy]}")

    # Split ignore patterns
    local -a ignore_patterns
    ignore_patterns=("${(@s.:.)WB_CONFIG[ignore]}")

    # Process each copy pattern
    for pattern in "${patterns[@]}"; do
        wb_log_progress "Processing pattern: $pattern"
        # Use find to get matching files
        while IFS= read -r -d '' file; do
            rel_path="${file#$git_root/}"
            dest_dir="$worktree_path/${rel_path:h}"
            wb_log_progress "  Copying $rel_path"
            mkdir -p "$dest_dir"
            if ! cp -a "$file" "$dest_dir/" 2>/dev/null; then
                echo "WARNING: Could not copy $file | ACTION: You may need to copy this file manually"
            fi
        done < <(find "$git_root" -path "$git_root/.git" -prune -o -name "$pattern" -print0 2>/dev/null)

        # Also try glob expansion for directory patterns
        for file in "$git_root"/$~pattern(N); do
            if [[ -e "$file" ]]; then
                rel_path="${file#$git_root/}"
                dest_dir="$worktree_path/${rel_path:h}"
                wb_log_progress "  Copying $rel_path"
                mkdir -p "$dest_dir"
                if ! cp -a "$file" "$dest_dir/" 2>/dev/null; then
                    echo "WARNING: Could not copy $file | ACTION: You may need to copy this file manually"
                fi
            fi
        done
    done

    wb_log_progress "Config files copied"
fi

# Run post-create commands
if [[ -n "${WB_CONFIG[post_create]}" ]]; then
    wb_log_milestone "Running post-create commands..."
    cd "$worktree_path"

    # Handle multi-line post_create (newline or semicolon separated)
    local -a post_create_cmds
    post_create_cmds=("${(@s.;.)WB_CONFIG[post_create]}")
    for cmd in "${post_create_cmds[@]}"; do
        [[ -z "${cmd// /}" ]] && continue
        wb_log_progress "  Running: $cmd"
        if ! eval "$cmd"; then
            echo "WARNING: Post-create command failed: $cmd | ACTION: You may need to run this manually"
        fi
    done

    wb_log_progress "Post-create commands completed"
fi

# Output results
wb_output_start
wb_output_field "status" "success"
wb_output_field "branch" "$branch_name"
wb_output_field "worktree" "$worktree_path"
wb_output_end
