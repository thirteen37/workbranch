#!/usr/bin/env zsh
# wb-rm - Remove a git worktree
# Usage: wb-rm <worktree-path> [--delete-branch]

set -euo pipefail

SCRIPT_DIR="${0:A:h}"
source "$SCRIPT_DIR/wb-lib"

usage() {
    echo "Usage: wb-rm <worktree-path> [--delete-branch] [--verbose] [--json]"
    echo ""
    echo "Removes the specified git worktree."
    echo ""
    echo "Options:"
    echo "  --delete-branch    Also delete the branch after removing worktree"
    echo "  --verbose          Show detailed progress information"
    echo "  --json             Output results in JSON format"
    exit 1
}

# Parse output control flags first
wb_parse_output_flags "$@"
set -- "${WB_REMAINING_ARGS[@]}"

# Parse arguments
if [[ $# -lt 1 ]]; then
    usage
fi

# Handle help flag
if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    usage
fi

worktree_path="$1"
delete_branch=false

shift
while [[ $# -gt 0 ]]; do
    case "$1" in
        --delete-branch) delete_branch=true ;;
        -h|--help) usage ;;
        *) echo "ERROR: Unknown option: $1 | ACTION: Use -h or --help to see valid options"; exit 1 ;;
    esac
    shift
done

# Verify we're in a git repository
git_root=$(wb_require_git_root)

# Check if running in sandbox
if wb_detect_sandbox; then
    echo "ERROR: Running in sandbox environment with restricted write access | ACTION: Use one of these approaches:"
    echo "  1. Run outside sandbox (turn off sandbox with /sandbox command)"
    echo "  2. Use read-only commands: wb-list, wb-status"
    echo "  3. Use dry-run mode: wb-done --dry-run, wb-nuke --dry-run"
    exit 1
fi

# Normalize path (make absolute, resolve ..)
worktree_path=$(wb_normalize_path "$worktree_path" "$(pwd)")

# Check if worktree exists
if ! git worktree list --porcelain | grep -q "^worktree $worktree_path$"; then
    echo "ERROR: No worktree found at $worktree_path | ACTION: Check path with wb-list"
    exit 1
fi

# Get branch name from worktree
branch_name=""
in_target=false
while IFS= read -r line; do
    if [[ "$line" == "worktree $worktree_path" ]]; then
        in_target=true
    elif $in_target; then
        if [[ "$line" =~ '^branch refs/heads/(.+)$' ]]; then
            branch_name="$match[1]"
            break
        elif [[ "$line" =~ '^worktree' ]]; then
            break
        fi
    fi
done < <(git worktree list --porcelain)

# Check if this is the main worktree
main_worktree=$(wb_get_main_worktree)
if [[ "$worktree_path" == "$main_worktree" ]]; then
    echo "ERROR: Cannot remove main worktree | ACTION: This is the primary repository, not a worktree"
    exit 1
fi

# Remove worktree
wb_log_milestone "Removing worktree at $worktree_path..."

wb_log_progress "Executing git worktree remove"
if ! wb_run_git worktree remove "$worktree_path"; then
    if [[ "$WB_GIT_STDERR" =~ "changes" || "$WB_GIT_STDERR" =~ "modified" || "$WB_GIT_STDERR" =~ "uncommitted" ]]; then
        echo "ERROR: Worktree has uncommitted changes | ACTION: Commit or stash changes before removing, or use 'rm -rf' to force"
    else
        echo "ERROR: Failed to remove worktree | ACTION: Rerun with --verbose to see git output"
    fi
    exit 1
fi

wb_log_progress "Worktree removed successfully"

# Delete branch if requested
branch_deleted="false"
if $delete_branch && [[ -n "$branch_name" ]]; then
    wb_log_milestone "Deleting branch '$branch_name'..."

    # Try safe delete first
    wb_log_progress "Attempting safe branch delete (git branch -d)"
    if wb_run_git branch -d "$branch_name"; then
        wb_log_progress "Branch deleted successfully"
        branch_deleted="true"
    else
        if [[ "$WB_GIT_STDERR" =~ "not fully merged" ]]; then
            echo "WARNING: Branch not fully merged"
            echo "ERROR: Cannot delete unmerged branch | ACTION: Use 'git branch -D $branch_name' to force delete"
        else
            echo "ERROR: Failed to delete branch | ACTION: Rerun with --verbose to see git output"
        fi
        exit 1
    fi
fi

# Output structured results
wb_output_start
wb_output_field "status" "success"
wb_output_field "worktree" "$worktree_path"
if [[ -n "$branch_name" ]]; then
    wb_output_field "branch" "$branch_name"
    wb_output_field "branch_deleted" "$branch_deleted"
fi
wb_output_end
